# Supabase project credentials (Project Settings → API).
# Both are safe to expose: they ship in the browser bundle. Access is governed by
# row level security policies, not by keeping these secret.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Comma-separated Supabase user ids allowed into /admin.
ADMIN_UUIDS="00000000-0000-0000-0000-000000000000"
