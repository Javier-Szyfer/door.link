# Cloudflare R2 (Dashboard → R2). Server-only: never prefix these with NEXT_PUBLIC_.
R2_ACCOUNT_ID="your-cloudflare-account-id"
# API token scoped to the two buckets below with "Object Read & Write".
R2_ACCESS_KEY_ID="your-access-key-id"
R2_SECRET_ACCESS_KEY="your-secret-access-key"
# Public bucket for audio and artwork, served from NEXT_PUBLIC_MEDIA_URL.
R2_MEDIA_BUCKET="door-media"
# Private bucket holding mixtapes.json and its history. Give it no public access.
R2_DATA_BUCKET="door-data"

# Custom domain connected to the media bucket.
NEXT_PUBLIC_MEDIA_URL="https://media.keyholemedia.store"

# Admin login. Generate the hash with: bun run hash-password
ADMIN_PASSWORD_HASH="salt-hex:hash-hex"
# Signs the admin session cookie. Generate with: openssl rand -base64 32
# Changing it signs everyone out.
SESSION_SECRET="random-32-byte-string"
