{
  "name": "door-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "bun run build:sw && next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "node --test \"src/**/*.test.ts\"",
    "splash": "node scripts/generate-splash.ts",
    "build:sw": "bun build src/sw/sw.ts --outfile public/sw.js --target browser --minify"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.68.0",
    "motion": "^14.9.1",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.19",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
